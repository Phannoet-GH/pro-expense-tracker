# Server & Database Configuration
PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pro_expense_tracker

# Gmail SMTP Configuration for PRO Upgrade Notifications
# 1. GMAIL_USER: Your Gmail address (e.g. sender/admin)
GMAIL_USER=your-email@gmail.com

# 2. GMAIL_APP_PASSWORD: 16-character Google App Password (NOT your normal password!)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. ADMIN_EMAIL: Recipient Gmail that receives client upgrade requests (can be same as GMAIL_USER)
ADMIN_EMAIL=your-email@gmail.com
